{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "catalog_hash",
    "sets_hash",
    "schema_hash",
    "engine_hash",
    "assessment_target",
    "git_snapshot",
    "id",
    "project_id",
    "mode",
    "created_at",
    "authorization_ref",
    "selectors",
    "exclusions",
    "assigned_control_ids",
    "features",
    "validity_days",
    "validity_policy_ref",
    "snapshot",
    "capabilities",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1"
    },
    "catalog_version": {
      "const": "3.1.0"
    },
    "catalog_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sets_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engine_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assessment_target": {
      "enum": [
        "source",
        "runtime"
      ]
    },
    "git_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "base_ref",
        "digest"
      ],
      "properties": {
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "review",
        "validation"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "selectors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assigned_control_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          true,
          false,
          null
        ]
      }
    },
    "validity_days": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 365
    },
    "validity_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "source_revision",
        "environment",
        "deployment",
        "files",
        "digest"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "deployment": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capabilities": {
      "const": [
        "read_explicit_files",
        "validate_records",
        "emit_report"
      ]
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-assurance:manifest:3.1"
}
