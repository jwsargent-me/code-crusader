{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-assurance:catalog:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "catalog_id",
    "catalog_version",
    "purpose",
    "feature_keys",
    "applicability_rules",
    "freshness_policies",
    "gate_policy",
    "references",
    "modules",
    "control_defaults",
    "controls"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "feature_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "applicability_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all",
        "any_of",
        "unknown"
      ],
      "properties": {
        "all": {
          "type": "string",
          "minLength": 1
        },
        "any_of": {
          "type": "string",
          "minLength": 1
        },
        "unknown": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "freshness_policies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "max_age_days",
          "meaning"
        ],
        "properties": {
          "max_age_days": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 365
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_gate",
        "rules"
      ],
      "properties": {
        "research_gate": {
          "const": "needs_validation"
        },
        "rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "kind",
          "pinned_version"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "pinned_version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "applicability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "$ref": "#/$defs/applicability"
          }
        }
      }
    },
    "control_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires",
        "research",
        "validation",
        "failure_significance",
        "freshness"
      ],
      "properties": {
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permitted_mode",
            "evidence_required"
          ],
          "properties": {
            "permitted_mode": {
              "const": "read_only"
            },
            "evidence_required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_required",
            "authorization"
          ],
          "properties": {
            "evidence_required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "authorization": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "failure_significance": {
          "$ref": "#/$defs/significance"
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_ref",
            "invalidate_on"
          ],
          "properties": {
            "policy_ref": {
              "type": "string",
              "minLength": 1
            },
            "invalidate_on": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control"
      }
    }
  },
  "$defs": {
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "any_of"
      ],
      "properties": {
        "any_of": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "git_observation",
          "runtime_evidence"
        ]
      }
    },
    "significance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assess",
        "default_severity",
        "default_gate"
      ],
      "properties": {
        "assess": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "default_severity": {
          "const": "unassessed"
        },
        "default_gate": {
          "const": "needs_review"
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "invalidate_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "title",
        "applicability",
        "expected_outcome",
        "research",
        "validation",
        "reference_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{2,}$"
        },
        "module_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "expected_outcome": {
          "type": "string",
          "minLength": 1
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "evidence_required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "permitted_mode": {
              "const": "read_only"
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "negative_case_required"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "evidence_required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "authorization": {
              "type": "string",
              "minLength": 1
            },
            "negative_case_required": {
              "type": "boolean"
            }
          }
        },
        "failure_significance": {
          "$ref": "#/$defs/significance"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "false_positive_guidance": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "$ref": "#/$defs/requires"
        }
      }
    },
    "effectiveControl": {
      "allOf": [
        {
          "$ref": "#/$defs/control"
        },
        {
          "required": [
            "requires",
            "failure_significance",
            "freshness"
          ],
          "properties": {
            "research": {
              "required": [
                "method",
                "evidence_required",
                "permitted_mode"
              ]
            },
            "validation": {
              "required": [
                "method",
                "evidence_required",
                "authorization",
                "negative_case_required"
              ]
            },
            "freshness": {
              "required": [
                "policy_ref",
                "invalidate_on"
              ]
            }
          }
        }
      ]
    },
    "namedSets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sets"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
        },
        "sets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
